# ============================================================
# Hawk Monorepo — Global Environment Variables Example
# (Shared across Discord Bot & Next.js Web Dashboard)
# ============================================================
# Copy this file to .env at the root of the monorepo and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Discord Bot Credentials ──────────────────────────────────
# Primary bot token from Discord Developer Portal -> Bot -> Reset Token
BOT_TOKEN=
# DISCORD_TOKEN is an alias for BOT_TOKEN (can leave empty if BOT_TOKEN is set)
DISCORD_TOKEN=

# ── Discord Application ──────────────────────────────────────
# Application / Bot Client ID (from Discord Developer Portal -> General Information)
CLIENT_ID=
DISCORD_CLIENT_ID=

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, self-hosted, etc.)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=

# ── Developer Logging & Webhooks ─────────────────────────────
# Discord webhook URL for developer logging, alerts, and audit records
DEV_WEBHOOK_URL=

# ── Discord Guild IDs ────────────────────────────────────────
# Primary production guild ID
MAIN_GUILD_ID=
# Testing/debugging guild ID (optional, defaults to MAIN_GUILD_ID)
TEST_GUILD_ID=
# Custom emoji guild ID (optional, can be same as MAIN_GUILD_ID)
EMOJI_GUILD_ID=

# ── Permissions & Access Control ─────────────────────────────
# Bot Owner Discord user ID(s) (comma-separated for multiple owners)
BOT_OWNER_ID=
# Bot Administrator Discord user IDs (comma-separated, bypass commands & dashboard)
BOT_ADMIN_IDS=

# ── Web Dashboard Security & Authentication ──────────────────
# Authentication is 100% Discord Bot OTP-based via direct messages.
# Sessions are stored in PostgreSQL with 24-hour expiration.

# ── Server & Environment ─────────────────────────────────────
# 'development' or 'production'
NODE_ENV=development
# Port for Web Dashboard (default: 3000)
PORT=3000
SERVER_PORT=3000
DASHBOARD_PORT=3000
