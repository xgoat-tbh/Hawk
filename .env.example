# ============================================================
# Hawk Discord Bot — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Discord ──────────────────────────────────────────────────
# Bot token from the Discord Developer Portal
BOT_TOKEN=

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (e.g. from Neon, Supabase, etc.)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=

# ── Developer Logging ────────────────────────────────────────
# Discord webhook URL for developer/audit logs
DEV_WEBHOOK_URL=

# ── Guild IDs ────────────────────────────────────────────────
# Primary production guild ID
MAIN_GUILD_ID=

# Testing/debugging guild ID
TEST_GUILD_ID=

# Guild where custom emojis are stored (can be same as main)
EMOJI_GUILD_ID=

# ── Bot Owner / Administrators ───────────────────────────────
# Bot owner Discord user ID
BOT_OWNER_ID=

# Comma-separated bot administrator user IDs (bypass normal permissions, not owner-only)
BOT_ADMIN_IDS=

# ── Environment ──────────────────────────────────────────────
# 'development' or 'production'
NODE_ENV=development
